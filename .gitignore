# Large AADR genotype data lives outside the repository.
# Guard against accidentally committing any copy.
config.local.yaml
*.geno
*.snp
*.ind
*.anno
*.tar
*.tar.gz
*.md5sum

# Prevent additional alignment files from being committed accidentally. The
# five already-tracked PRJEB10597 BAMs are documented exceptions in DATA.md.
*.bam
*.bai
*.cram
*.crai

# run logs
results/*.log

# OS
.DS_Store
Thumbs.db
results/plink/
results/f2_admixtools/
results/lea/*.geno
tmp/
output/pdf/
reports/etruscan_publication/

# Pooled-frequency cache for neanderthal_source.py (regenerable in one pass)
results/neanderthal_source_cache/

# Per-run resume markers written alongside generated result tables
results/**/.sensitivity.json

# Upstream phase intermediates. These exist only to produce the phase-4
# analysis tables, which stay tracked because every published study reads them
# (see docs/DATA.md). Regenerate with scripts/run_pipeline.py when AADR is local.
results/phase2_*_metadata.csv
results/phase2_*_sample_manifest.csv
results/phase2_1240k_excluded.csv
results/phase3_*_estimates.csv
results/phase5_*_pca.csv
results/phase6_*_residuals.csv
results/highest_archaic/suspicious_outliers.tsv

# Papuan Denisovan admixture-dating run products and resumable transfers
archaic_admixture_dating/outputs/*
!archaic_admixture_dating/outputs/.gitkeep
*.part

# Workspace siblings — not part of the pipeline repo
.claude/
.codex/
WORKSPACE.md
archive/
other-projects/
native_american_denisovan_project/
data/vcf/
data/testdata/
data/1_vindija_exome_hg19_1000g_LowQualDeamination.md.bam.annotated_1.3-14gatk.vcf.gz

# Downloaded archaic genome BCFs (Zenodo 7246376, ~1.3 GB) - regenerate with
# scripts/fetch_archaic_bcf.py rather than committing.
data/archaic_hg19/

# Regenerable from the archaic BCFs via scripts/import_archaic_bcf.py (~100 min).
# The small CSVs beside it are tracked; the 38 MB frequency array is not.
results/archaic_panel/archaic_1240k_freqs.npz
